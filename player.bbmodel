],"uuid":"335deef2-bdd3-ace9-69eb-9d33a9733541","time":0.75,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"-105","y":"-40","z":"-65"}],"uuid":"57ec7a57-1e8f-d2a5-ee69-d0d7643d8600","time":1,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"da39b5b2-0d72-70d9-7e01-667b673ff5ab","time":2,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"-80","y":"-40","z":"-65"}],"uuid":"374c1c1f-c499-f4ef-04e8-e26a02ec6922","time":1.25,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"-105","y":"-40","z":"-65"}],"uuid":"c0dea5d2-09de-a6fb-8923-e55bc1441724","time":1.5,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"0","y":"-1","z":"0"}],"uuid":"bc44cec9-073d-36fb-17eb-425a27b15d01","time":0.5,"color":-1,"interpolation":"linear"},{"channel":"position","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"f74e0c8d-75e8-991a-5e74-4a12637aa8b5","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"0","y":"-1","z":"0"}],"uuid":"9096f2d0-d3c4-a9d1-ad02-644c306d8e50","time":1.5,"color":-1,"interpolation":"linear"},{"channel":"position","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"a2ddf22c-1536-c912-f71a-5fb304f1f5f2","time":2,"color":-1,"interpolation":"catmullrom"}]}}},{"uuid":"a297cb81-1785-b3a7-c383-b7bf3749d385","name":"armsPointUp","loop":"hold","override":true,"length":0.04167,"snapping":24,"selected":true,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"effects":{"name":"Effects","type":"effect","keyframes":[{"channel":"timeline","data_points":[{"script":"function removeArmRotationOffset()\n    models.player.root.Center.Torso.RightArm:setOffsetRot(math.lerp(\n        models.player.root.Center.Torso.RightArm:getOffsetRot(),\n        vec(0, 0, 0),\n        15 / client:getFPS())\n    )\n    if models.player.root.Center.Torso.RightArm:getOffsetRot()[1] < 0.0001 and models.player.root.Center.Torso.RightArm:getOffsetRot()[2] < 0.0001 and models.player.root.Center.Torso.RightArm:getOffsetRot()[3] < 0.0001 then\n        models.player.root.Center.Torso.RightArm:setOffsetRot(0, 0, 0)\n        events.render:remove(\"armsPointUp\")\n    end\nend\n\nfunction setArmRotationOffset()\n    local headRotation = (vanilla_model.HEAD:getOriginRot() + 180) % 360 - 180\n\n    models.player.root.Center.Torso.RightArm:setOffsetRot(math.lerp(\n        models.player.root.Center.Torso.RightArm:getOffsetRot(),\n        headRotation,\n        15 / client:getFPS())\n    )\n\n    if animations.player.armsPointUp:getPlayState() == \"STOPPED\" then\n        events.render:remove(\"armsPointUp\")\n        events.render:register(removeArmRotationOffset, \"armsPointUp\")\n    end\nend\n\nevents.render:register(setArmRotationOffset, \"armsPointUp\")\n"}],"uuid":"5c07d2ba-767e-099b-ee77-9d72abaa10ce","time":0,"color":-1,"interpolation":"linear"}]},"d994037b-c4fb-4f38-a9e6-ccb860d404e4":{"name":"RightArm","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":"-90","y":"0","z":"0"}],"uuid":"c7fb78a1-f3c3-ff2f-2645-c239767e99af","time":0,"color":-1,"interpolation":"linear"}]},"36ffe8b4-febd-4d8c-a1c8-531aa218dec1":{"name":"RightItemPivotWide","type":"bone","keyframes":[{"channel":"scale","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"c54af679-9954-b1dd-0093-021e4fc23fb1","time":0,"color":-1,"uniform":true,"interpolation":"linear"}]}}}]}